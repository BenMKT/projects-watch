# Data source: "mock" for Vercel demo (no live DB) | "prisma" for real SQLite/Postgres
DATA_SOURCE="mock"

# Used when DATA_SOURCE=prisma
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

ENCRYPTION_KEY="cdw-dev-encryption-key-32chars!!"
ANONYMISATION_SALT="cdw-anon-salt-change-me"

# Evidence photos + Chamber Briefing attachments
# BLOB_READ_WRITE_TOKEN=""

# =============================================================================
# AI providers — demo defaults (safe, no paid APIs)
# =============================================================================
SENTIMENT_PROVIDER="mock"
CLUSTER_PROVIDER="grid"
VOICE_STT_PROVIDER="browser"
VISION_PROVIDER="mock"

# Shared OpenAI key (used by openai sentiment + vision + Whisper when remote)
# OPENAI_API_KEY="sk-..."

# --- Sentiment: mock | openai | remote (HF/custom HTTP) ---
# SENTIMENT_PROVIDER="openai"
# SENTIMENT_MODEL="gpt-4o-mini"
# SENTIMENT_TIMEOUT_MS="12000"
# SENTIMENT_PROVIDER="remote"
# SENTIMENT_API_URL="https://api-inference.huggingface.co/models/distilbert-base-uncased-finetuned-sst-2-english"
# SENTIMENT_API_KEY="hf_..."

# --- Clustering (local only — not an LLM): grid | supercluster ---
# CLUSTER_PROVIDER="supercluster"

# --- Voice STT: browser | remote (defaults to OpenAI Whisper if OPENAI_API_KEY set) ---
# VOICE_STT_PROVIDER="remote"
# VOICE_STT_API_URL="https://api.openai.com/v1/audio/transcriptions"
# VOICE_STT_API_KEY=""   # optional; falls back to OPENAI_API_KEY
# VOICE_STT_MODEL="whisper-1"
# VOICE_STT_LANG="en"

# --- Photo vision: mock | remote (GPT-4o-mini) ---
# VISION_PROVIDER="remote"
# VISION_API_URL="https://api.openai.com/v1/chat/completions"
# VISION_API_KEY=""      # optional; falls back to OPENAI_API_KEY
# VISION_MODEL="gpt-4o-mini"

# =============================================================================
# Production pattern (single OpenAI key + Supercluster + Prisma/Blob)
# =============================================================================
# DATA_SOURCE="prisma"
# DATABASE_URL="postgresql://..."
# OPENAI_API_KEY="sk-..."
# SENTIMENT_PROVIDER="openai"
# VOICE_STT_PROVIDER="remote"
# VISION_PROVIDER="remote"
# CLUSTER_PROVIDER="supercluster"
# BLOB_READ_WRITE_TOKEN="..."
